# ---- On your computer (npm run dev) ----
DATABASE_URL="file:data/papr.db"
APP_URL="http://localhost:3000"
DOI_PREFIX="10.99999"
# Shows login codes on screen so you can test without email. MUST be "false" on the live site.
SHOW_DEV_CODES="true"
# Optional: better slide outlines with Claude
ANTHROPIC_API_KEY=""

# ---- On Vercel (Project > Settings > Environment Variables) ----
# Set automatically by the integrations:
#   TURSO_DATABASE_URL, TURSO_AUTH_TOKEN   (Turso integration, from the Storage tab)
#   BLOB_READ_WRITE_TOKEN                  (Blob store, from the Storage tab)
# Add these yourself:
#   SHOW_DEV_CODES="false"
#   ADMIN_EMAILS="you@example.com"           (these emails become admins when they log in)
#   RESEND_API_KEY="re_..."                  (from resend.com, to really send emails)
#   EMAIL_FROM="papr <hello@yourdomain.com>" (an address on a domain you verified in Resend)
#   CRON_SECRET="any-long-random-text"       (protects the daily/weekly jobs)
#   APP_URL="https://your-site.vercel.app"   (optional; defaults to the Vercel production domain)
#   DOI_PREFIX="10.99999"
